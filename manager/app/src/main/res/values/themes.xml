<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.KernelSU" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <style name="Theme.KernelSU.Starting" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.KernelSU</item>
        <!--
          KuaiMaoSU 冷启动：只保留 Compose 的动画首屏。
          系统启动窗口不再画图标（透明图标 + 同色底），
          这样用户看到的第一个画面就是 KuaiMaoSplash，不再是「图标静止页」。
        -->
        <item name="windowSplashScreenBackground">@color/kuaimao_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/kuaimao_ink</item>
        <item name="android:windowBackground">@color/kuaimao_ink</item>
    </style>

    <style name="Theme.KernelSU.WebUI" parent="Theme.KernelSU">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

</resources>

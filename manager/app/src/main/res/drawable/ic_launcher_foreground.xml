<?xml version="1.0" encoding="utf-8"?>
<!--
  Loom SU 应用图标前景（新版）：「织」出来的 L。
  一根经线垂直落下、一根纬线向右折出，构成 L 的骨架；
  中部一道半透明纬纱穿过，结点用暖金标出，寓意经纬交织。
  图形收在 108dp 视口中心安全区内，可被任意形状遮罩裁切。

  注：Android VectorDrawable 的渐变按路径包围盒计算，
  直线笔画包围盒宽/高为 0 时渐变会失效，因此这里全部使用实色。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 经线（垂直笔画） -->
    <path
        android:pathData="M44,34 L44,69"
        android:strokeColor="#FF8CF0FF"
        android:strokeWidth="10"
        android:strokeLineCap="round" />

    <!-- 纬线（水平笔画） -->
    <path
        android:pathData="M44,69 L76,69"
        android:strokeColor="#FF9C86FF"
        android:strokeWidth="10"
        android:strokeLineCap="round" />

    <!-- 穿过经线的半透明纬纱，制造编织感 -->
    <path
        android:pathData="M33,50 L58,50"
        android:strokeColor="#8CA9B4FF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />

    <!-- 经纬结点 -->
    <path
        android:pathData="M44,50 m-7.6,0 a7.6,7.6 0 1,0 15.2,0 a7.6,7.6 0 1,0 -15.2,0"
        android:strokeColor="#66FFD9A0"
        android:strokeWidth="1.4" />
    <path
        android:pathData="M44,50 m-4.8,0 a4.8,4.8 0 1,0 9.6,0 a4.8,4.8 0 1,0 -9.6,0"
        android:fillColor="#FFFFD9A0" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- 启动第一屏：Aurora Glass 品牌渐变 135°（紫 → 品红），不再是纯黑 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#FF6C5CE7"
                android:centerColor="#FFA855F7"
                android:endColor="#FFEC4899"
                />
        </shape>
    </item>
</layer-list>

ccflags-y += -I$(srctree)/security/selinux -I$(srctree)/security/selinux/include
ccflags-y += -I$(objtree)/security/selinux -include $(srctree)/include/uapi/asm-generic/errno.h

ifneq ($(KBUILD_EXTMOD),)
# 6.18 exports the external module source as srcroot when M/MO are used.
ifneq ($(srcroot),)
KSU_KERNEL_DIR := $(srcroot)
endif
endif
ifndef KSU_KERNEL_DIR
ifeq ($(filter /%,$(src)),)
KSU_KERNEL_DIR := $(srctree)/$(src)
else
KSU_KERNEL_DIR := $(src)
endif
endif

ccflags-y += -I$(KSU_KERNEL_DIR) -I$(KSU_KERNEL_DIR)/include

# preinit runner: a static nolibc binary embedded into kernelsu, see preinit/.
# It is built against the installed UAPI headers of the target kernel
# (CONFIG_HEADERS_INSTALL, enabled by gki_defconfig).
KSU_UAPI_INC := $(objtree)/usr/include
ifneq ($(wildcard $(KSU_UAPI_INC)/linux/unistd.h),)
kernelsu-objs += preinit/preinit.o
kernelsu-objs += preinit/blob.o

KSU_RUNNER_CFLAGS := $(CLANG_FLAGS) -std=gnu11 -Os -Wall \
	-nostdinc -isystem $(shell $(CC) -print-file-name=include) \
	-I$(KSU_KERNEL_DIR)/preinit/runner/nolibc -I$(KSU_UAPI_INC) \
	-I$(KSU_KERNEL_DIR)/include \
	-ffreestanding -fno-stack-protector -fno-pic -fno-pie \
	-fno-asynchronous-unwind-tables -fno-unwind-tables \
	-ffunction-sections -fdata-sections

quiet_cmd_ksu_runner = RUNNER  $@
      cmd_ksu_runner = $(CC) $(KSU_RUNNER_CFLAGS) -c -o $@.o $< && \
		$(LD) -static -nostdlib -e _start --gc-sections -s -o $@ $@.o && \
		rm -f $@.o

$(obj)/preinit/runner.elf: $(KSU_KERNEL_DIR)/preinit/runner/runner.c \
		$(wildcard $(KSU_KERNEL_DIR)/preinit/runner/nolibc/*.h \
			   $(KSU_KERNEL_DIR)/preinit/runner/nolibc/sys/*.h \
			   $(KSU_KERNEL_DIR)/include/uapi/*.h) FORCE
	$(call if_changed,ksu_runner)

targets += preinit/runner.elf
$(obj)/preinit/blob.o: $(obj)/preinit/runner.elf
asflags-y += -DKSU_PREINIT_RUNNER_BIN=\"$(obj)/preinit/runner.elf\"
else
$(warning -- KernelSU: $(KSU_UAPI_INC) not found, preinit disabled)
ccflags-y += -DKSU_NO_PREINIT
endif

obj-$(CONFIG_KSU) += kernelsu.o

MDIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

# Workaround bazel
# https://github.com/tiann/KernelSU/pull/316#issuecomment-1479043219
GIT := $(shell PATH="$$PATH":/usr/bin:/usr/local/bin which git)
ifneq ($(GIT),)
# Check if this is a git repository
# Try to detect Git repo intelligently
GIT_ROOT := $(shell cd $(MDIR) && $(GIT) rev-parse --show-toplevel 2>/dev/null)
ifneq ($(GIT_ROOT),)
KERNEL_GIT_ROOT := $(shell cd $(srctree) && $(GIT) rev-parse --show-toplevel 2>/dev/null)
ifneq ($(GIT_ROOT),$(KERNEL_GIT_ROOT))
# Only set version if it's a different repo from kernel
$(shell cd $(GIT_ROOT) && [ -f .git/shallow ] && $(GIT) fetch --unshallow 2>/dev/null || true)
KSU_GIT_VERSION := $(shell cd $(GIT_ROOT) && $(GIT) rev-list --count HEAD 2>/dev/null)
KSU_GIT_VERSION_VALID := 1
$(info -- KernelSU: Git repo detected at $(GIT_ROOT))
endif
endif
else
$(warning -- KernelSU: Git not detected, make sure git is installed in your PATH!)
endif


# 版本号必须与管理器同源，否则「刷写成功却依旧提示需要更新」永远消不掉。
#
# 管理器侧 versionCode = major*10000 + minor*100 + patch，直接读仓库根的 VERSION
# 文件（见 manager/build.gradle.kts 的 readVersionFile 注释）；内核侧原来算的是
# 30000 + git 提交数，两套算法一起步就对不上：3.0.52 的 APK 是 30052，同一份代码
# 编译出来的 .ko 却是 30049。管理器拿内核上报的 30049 和自己 30052 一比，永远
# 认为内核落后，于是刷写多少次都还在提示更新。
#
# 现在内核也读同一个 VERSION 文件，两边由同一个数派生。git 提交数只作为
# 脱离仓库独立编译时的兜底，不再参与正式版本号。
KSU_VERSION_FILE := $(wildcard $(MDIR)/../VERSION)
ifneq ($(strip $(KSU_VERSION_FILE)),)
KSU_VERSION_TEXT := $(shell tr -d ' \t\r\n' < $(KSU_VERSION_FILE))
KSU_VERSION_PARTS := $(subst ., ,$(KSU_VERSION_TEXT))
KSU_VERSION := $(shell expr \( $(word 1,$(KSU_VERSION_PARTS)) \* 10000 \) + \( $(word 2,$(KSU_VERSION_PARTS)) \* 100 \) + $(word 3,$(KSU_VERSION_PARTS)) 2>/dev/null)
ifeq ($(shell echo "$(KSU_VERSION)" | grep -E '^[0-9]+$$'),)
$(warning -- KernelSU: VERSION file '$(KSU_VERSION_TEXT)' is not x.y.z, falling back)
KSU_VERSION :=
endif
endif

ifeq ($(strip $(KSU_VERSION)),)
ifdef KSU_GIT_VERSION_VALID
# No VERSION file: keep the old 30000 + commit-count rule for standalone builds.
KSU_VERSION := $(shell expr 30000 + $(KSU_GIT_VERSION))
$(warning -- KernelSU: VERSION not found, derived $(KSU_VERSION) from git history)
else
KSU_VERSION := 16
$(warning -- KernelSU: neither VERSION nor git available, using legacy version 16)
endif
endif

$(info -- KernelSU version: $(KSU_VERSION))
ccflags-y += -DKSU_VERSION=$(KSU_VERSION)

KSU_NEW_DCACHE_FLUSH := $(shell grep -q __flush_dcache_area $(srctree)/arch/arm64/include/asm/cacheflush.h ; echo $$?)
$(info -- KSU_NEW_DCACHE_FLUSH: $(KSU_NEW_DCACHE_FLUSH))

KSU_IS_PR_BUILD ?= 0
# 管理器识别：内核按「包名 + APK 签名」认管理器（manager/throne_tracker.c 的 crown_manager）。
# 这里的默认值必须是 FoxSu Manager 自己的包名与发布证书，否则内核永远不会把 FoxSu 认成管理器：
#   - 包名不匹配 → 连候选 APK 都不会被考虑（哪怕签名正确）
#   - 签名不匹配 → 候选被丢弃，状态栏显示"未安装"，只能靠动态管理器或改包名绕过去
# 签名值取自发布密钥 /opt/foxsu-build/foxsu.jks（证书 DER 864 字节，sha256 如下），
# 换签名时用 `scripts/manager-signature.sh` 重新生成。
ifeq ($(KSU_IS_PR_BUILD),0)
KSU_PACKAGE_NAME ?= com.foxsu.manager
else
KSU_PACKAGE_NAME ?= com.foxsu.manager.pr
endif
KSU_EXPECTED_SIZE ?= 0x0528
KSU_EXPECTED_HASH ?= b0ab9e7d3aab398cacb972cba34c2c561ea665bceace5f0d26681b834e923edd

$(info -- KernelSU Manager package name: $(KSU_PACKAGE_NAME))
$(info -- KernelSU Manager signature size: $(KSU_EXPECTED_SIZE))
$(info -- KernelSU Manager signature hash: $(KSU_EXPECTED_HASH))
$(info -- KernelSU is PR Build: $(KSU_IS_PR_BUILD))

ccflags-y += -DKSU_PACKAGE_NAME=\"$(KSU_PACKAGE_NAME)\"
ccflags-y += -DEXPECTED_SIZE=$(KSU_EXPECTED_SIZE)
ccflags-y += -DEXPECTED_HASH=\"$(KSU_EXPECTED_HASH)\"
ccflags-y += -DKSU_IS_PR_BUILD=$(KSU_IS_PR_BUILD)

ccflags-y += -DKSU_NEW_DCACHE_FLUSH=$(KSU_NEW_DCACHE_FLUSH)

ccflags-y += -Wno-strict-prototypes -Wno-int-conversion -Wno-gcc-compat -Wno-missing-prototypes
ccflags-y += -Wno-declaration-after-statement -Wno-unused-function

